{
  "title": "Industrial Laundry — Operational",
  "uid": "laundry-operational",
  "version": 1,
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "tags": ["laundry", "operations"],
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Event Ingest Rate (last 5m)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "rate(laundry_events_ingested_total[5m])",
          "legendFormat": "events/s"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Stuck Batches",
      "description": "Alert threshold: > 5 batches",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "laundry_stuck_batches",
          "legendFormat": "stuck"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Inactive Stations",
      "description": "Alert threshold: any station silent > 15min",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "laundry_inactive_stations",
          "legendFormat": "inactive"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Offline Devices",
      "description": "Alert threshold: any device offline",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "laundry_device_offline_count",
          "legendFormat": "offline"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Event Ingest Latency — p50 / p95 / p99",
      "description": "Alert threshold: p99 > 200ms",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(laundry_event_ingest_latency_seconds_bucket[5m])) * 1000",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(laundry_event_ingest_latency_seconds_bucket[5m])) * 1000",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(laundry_event_ingest_latency_seconds_bucket[5m])) * 1000",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Redis Stream Backlog",
      "description": "Alert threshold: > 500 unprocessed events",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "laundry_redis_stream_backlog",
          "legendFormat": "backlog"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Event Ingest by Path (redis / direct_db / duplicate)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "rate(laundry_events_ingested_total{path='redis'}[5m])",
          "legendFormat": "redis (normal)"
        },
        {
          "expr": "rate(laundry_events_ingested_total{path='direct_db'}[5m])",
          "legendFormat": "direct_db (redis down)"
        },
        {
          "expr": "rate(laundry_events_ingested_total{path='duplicate'}[5m])",
          "legendFormat": "duplicate (idempotent retry)"
        }
      ]
    },
    {
      "id": 8,
      "type": "histogram",
      "title": "ASR Confidence Score Distribution",
      "description": "Alert threshold: avg < 0.85",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "options": {
        "bucketSize": "auto",
        "fillOpacity": 60
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.75 },
              { "color": "green", "value": 0.85 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "rate(laundry_asr_confidence_score_bucket[15m])",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Sync Failure Rate",
      "description": "Alert threshold: > 2% of events",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 7 },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.02 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "rate(laundry_sync_failures_total[5m]) / (rate(laundry_events_ingested_total[5m]) + 1e-9)",
          "legendFormat": "sync failure rate"
        }
      ]
    }
  ]
}
